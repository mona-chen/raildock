<% @accept_url ||= accept_url_for(@invitation) %>
<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 520px; margin: 0 auto; padding: 32px 24px; color: #0B0B0D;">
  <h1 style="font-size: 18px; font-weight: 600; margin: 0 0 16px;">
    Join <%= @organization.name %> on RailDock
  </h1>

  <p style="font-size: 14px; line-height: 1.5; margin: 0 0 16px;">
    <strong><%= @invited_by.name %></strong> has invited you to collaborate on
    <strong><%= @organization.name %></strong> as a <strong><%= @invitation.role %></strong>.
  </p>

  <p style="margin: 24px 0;">
    <a href="<%= @accept_url %>"
       style="display: inline-block; background: #8b5cf6; color: white; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 500; font-size: 14px;">
      Accept invitation
    </a>
  </p>

  <p style="font-size: 13px; color: #4A4A55; line-height: 1.5; margin: 0 0 8px;">
    Or paste this link into your browser:
  </p>
  <code style="display: block; font-size: 12px; color: #4A4A55; background: #f5f5f5; padding: 10px; border-radius: 6px; word-break: break-all;">
    <%= @accept_url %>
  </code>

  <p style="font-size: 12px; color: #4A4A55; margin-top: 24px;">
    This invitation expires on <%= @expires_at.strftime("%B %-d, %Y at %H:%M %Z") %>.
    If you weren't expecting this email, you can safely ignore it.
  </p>
</div>