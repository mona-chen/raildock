# RailDock Environment Variables
# Copy this file to .env and fill in the values

# Domain
RAILDOCK_DOMAIN=your-domain.com

# PostgreSQL
POSTGRES_PASSWORD=your-secure-password-here

# Rails Master Key (from config/master.key)
RAILS_MASTER_KEY=your-rails-master-key-here

# JWT Secret Key (generate with: rails secret)
JWT_SECRET_KEY=your-64-char-secret-key-here

# Lockbox Master Key (generate with: rails secret)
LOCKBOX_MASTER_KEY=your-64-char-lockbox-key-here

# Generic deploy webhook secret for /api/webhooks/deploy (generate with: rails secret)
WEBHOOK_SECRET=your-64-char-webhook-secret-here

# Public URL (used for invitation links and bootstrap scripts)
APP_URL=http://your-domain.com:8888
RAILDOCK_PUBLIC_URL=http://your-domain.com:8888

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@your-domain.com

# Email / SMTP (required for team invitations)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_DOMAIN=your-domain.com
# SMTP_AUTH=plain
# SMTP_STARTTLS=true
# MAIL_FROM=no-reply@your-domain.com

# Docker socket path (Linux: /var/run/docker.sock, macOS Colima: /var/run/colima/default.sock)
DOCKER_SOCK=/var/run/docker.sock
